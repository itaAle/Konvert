{
  "name": "konvert",
  "private": true,
  "version": "0.1.0",
  "description": "Audio and video converter that works entirely on your computer",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "setup:ffmpeg": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-ffmpeg.ps1",
    "cli": "cargo run -q -p konvert-cli --",
    "test": "node scripts/check-privacy.mjs && cargo test --workspace",
    "check:privacy": "node scripts/check-privacy.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "~2.11.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "~2.11.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
