{
  "name": "konvert",
  "private": true,
  "version": "0.1.0",
  "description": "Audio and video converter that works entirely on your computer",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "setup:ffmpeg": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-ffmpeg.ps1",
    "cli": "cargo run -q -p konvert-cli --",
    "test": "node scripts/check-privacy.mjs && vitest run && cargo test --workspace",
    "check:privacy": "node scripts/check-privacy.mjs",
    "test:ui": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tauri-apps/api": "~2.11.1",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "~2.11.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.5"
  }
}
