{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal permissions for the main window: Konvert's own commands and event listening. No shell, file system, HTTP, dialog or opener permissions are granted to the frontend: pickers and 'open file' run in Rust.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:default",
    "allow-engine-info",
    "allow-platform-info",
    "allow-app-ready",
    "allow-get-preferences",
    "allow-set-preferences",
    "allow-pick-folder",
    "allow-available-space",
    "allow-open-releases-page",
    "allow-reveal-log",
    "allow-clear-log",
    "allow-confirm-close",
    "allow-analyze-file",
    "allow-unlock-pdf",
    "allow-forget-pdf-password",
    "allow-plan-conversion",
    "allow-pdf-thumbnails",
    "allow-picture-thumbnail",
    "allow-start-conversion",
    "allow-start-combined",
    "allow-cancel-conversion",
    "allow-open-output",
    "allow-reveal-output",
    "allow-pick-files",
    "allow-pick-picture",
    "allow-take-launch-files",
    "allow-open-licenses"
  ]
}
